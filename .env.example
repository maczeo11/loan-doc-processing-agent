# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="<your-azure-key>"

# AWS Configuration (S3 & Bedrock)
AWS_ACCESS_KEY_ID="<your-aws-access-key>"
AWS_SECRET_ACCESS_KEY="<your-aws-secret-key>"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="finscan-loan-dossiers"

# LLM Providers
OPENAI_API_KEY="sk-proj-..."
# or for Azure OpenAI:
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"

# Local Edge LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_LLM_MODEL="qwen2.5:7b-instruct"

# Langfuse Observability
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# App Settings
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Local Docker Compose Runtime Settings
#
# Must match docker-compose.yml's `db` service password (defaults to
# "postgrespassword" if unset, same as before pgbouncer existed).
POSTGRES_PASSWORD="postgrespassword"
# App runtime connects through PgBouncer (infra/docker-compose.yml service
# `pgbouncer`, transaction-mode pooling) on :6432 - not Postgres's own :5432 -
# so N gunicorn workers x SQLAlchemy's own pool don't each open a full,
# separate set of Postgres backend connections. Local single-process dev
# without Docker running can point this straight at :5432 instead; either
# way DATABASE_STATEMENT_CACHE_SIZE=0 (apps/api/config.py) keeps asyncpg
# compatible with both.
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:6432/finscan"
# Migrations run DDL and must NOT go through PgBouncer's transaction pooling
# (see apps/api/config.py / apps/api/migrations/env.py) - point this at
# Postgres directly. Leave empty to fall back to DATABASE_URL as-is.
ALEMBIC_DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/finscan"
REDIS_URL="redis://localhost:6379/0"
QUEUE_BACKEND="postgres"
STORAGE_BACKEND="local"
STORAGE_BASE_DIR="data/storage"
API_PORT=8000
# gunicorn worker COUNT for the API (infra/systemd/finscan-api.service).
# Rule of thumb (2 x vCPU) + 1; this box is 2 vCPU, so 4 leaves headroom for
# Postgres/Redis/the worker process rather than maxing out at 5.
API_WORKERS=4
# How long an unchanged dossier's /questions answer is served from Redis
# before a fresh retrieval+synthesis pass (apps/api/routes/review.py).
QA_CACHE_TTL_SECONDS=900

# ==============================================================================
# Phase 7: AWS Cloud Deployment & Operations (Non-Secret Documentation)
# ==============================================================================
# Adapter selections for cloud
# STORAGE_BACKEND="s3"
S3_BUCKET="finscan-dossiers-production"
# QUEUE_BACKEND="sqs"
SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/finscan-jobs-production"
SQS_DLQ_URL="https://sqs.us-east-1.amazonaws.com/123456789012/finscan-jobs-dlq-production"

# Managed OCR fallback (Route 3: Textract DetectDocumentText, capped 100 pp).
# Keep "false" locally; cloud .env sets "true" to enforce the fallback.
FINSCAN_ENABLE_TEXTRACT="false"

# OCR escalation sensitivity: a page stays native only with >= MIN_CHARS and
# >= MIN_WORDS of text and < MAX_IMAGE_COVERAGE image area. Raise the minimums
# to escalate MORE pages to OCR; lower them to keep more pages native (faster).
FINSCAN_OCR_MIN_CHARS="100"
FINSCAN_OCR_MIN_WORDS="10"
FINSCAN_OCR_MAX_IMAGE_COVERAGE="0.5"

# EC2 & Caddy Production Domain
AWS_EC2_INSTANCE_ID="i-0123456789abcdef0"
DOMAIN_NAME="finscan.demo.internal"
ACME_EMAIL="admin@finscan.demo.internal"

# Version Stamping (derived automatically by infra/version.sh)
RELEASE_VERSION="1.0.0"
GIT_SHA="unknown"
BUILD_TIMESTAMP="unknown"
