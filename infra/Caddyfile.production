# ==============================================================================
# FinScan AI: Production Caddy Configuration with Automatic Let's Encrypt HTTPS
# ==============================================================================

{
    email {$ACME_EMAIL:admin@example.com}
    admin off
    # No real domain is configured yet (DOMAIN_NAME defaults to "localhost",
    # accessed via the EC2 IP) - Caddy's automatic HTTPS otherwise issues an
    # internal-CA cert for "localhost" and redirects all HTTP traffic to it,
    # which every client rejects (wrong hostname, untrusted CA) - this took
    # the whole site down the first time Caddy's container got recreated.
    # Remove this line (and the http:// prefix below) once a real domain +
    # DNS is in place (see docs/improvement_roadmap.md) so Let's Encrypt
    # auto-HTTPS takes over.
    auto_https off
}

http://{$DOMAIN_NAME:localhost} {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=3153600; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Cache the SPA correctly: hashed asset filenames (Vite's default
    # dist/assets/*-<hash>.js|css) are safe to cache forever, but index.html
    # is NOT - it's what references those hashed filenames. Without this,
    # browsers heuristically cache index.html too, so after a redeploy some
    # visitors keep loading a stale index.html pointing at JS/CSS chunks that
    # no longer exist (404s) or, worse, an older build (e.g. one predating a
    # VITE_AUTH_MODE change) - intermittently showing a broken or outdated
    # login screen instead of the current one.
    @immutable_assets path /assets/*
    header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

    @app_shell path / /index.html
    header @app_shell Cache-Control "no-cache, must-revalidate"

    # Reverse proxy to FastAPI application container
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Structured production logging
    log {
        output stdout
        format json
    }
}
