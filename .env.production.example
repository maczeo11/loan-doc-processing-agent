# FinScan AI — Production Cloud Configuration Example
# Copy to .env on EC2 and fill in real values before deploying.
# These values override the defaults in docker-compose.yml.

# ─── Runtime Environment ────────────────────────────────────────────
ENVIRONMENT=production
DOMAIN_NAME=finscan.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Session cookie Secure flag - must match reality, NOT just ENVIRONMENT.
# A Secure cookie set over plain HTTP is silently dropped by every browser
# (login "succeeds" then the next request 401s). Leave this false while the
# deployment is still HTTP-only (e.g. bare EC2 IP, no domain/TLS yet); flip
# to true ONLY once Caddy auto-HTTPS (or another TLS terminator) with a real
# domain is actually serving this deployment.
TLS_ENABLED=false

# ─── Auth (Firebase) ────────────────────────────────────────────────
# AUTH_MODE=google verifies incoming tokens as Firebase ID tokens
# (apps/api/auth/firebase_verify.py) - covers both Google sign-in AND
# Firebase email/password sign-in, since Firebase issues the same token
# shape for either. No service account/private key needed.
AUTH_MODE=google
FIREBASE_PROJECT_ID=cognizant-77c1a

# Allowlist: comma-separated. AUTHORIZED_DOMAINS grants every email on that
# domain (e.g. gitam.in below lets any @gitam.in Google/Workspace account
# sign in); AUTHORIZED_EMAILS allowlists specific individual addresses on top
# of that. Both only seed the `authorized` flag on a user's FIRST login (see
# apps/api/auth/allowlist.py) - editing these does nothing for someone who
# already signed in and got denied; use scripts/authorize_user.py for that.
AUTHORIZED_DOMAINS=gitam.in
AUTHORIZED_EMAILS=

JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# ─── Storage — S3 ───────────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=finscan-dossiers-production
AWS_REGION=us-east-1

# ─── Queue — SQS ────────────────────────────────────────────────────
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/finscan-jobs-production

# ─── OCR — managed fallback enforced ──────────────────────────────────
# Route 3 (AWS Textract DetectDocumentText, $0.0015/page) runs when native +
# CPU OCR both return empty. Hard-capped at 100 pages/runtime in
# core/extraction/router.py. Requires the FinScanTextractAccess IAM statement
# (infra/iam_policy.json) on the EC2 instance role; creds come from the role,
# never from static keys.
FINSCAN_ENABLE_TEXTRACT=true

# ─── Database (internal Docker bridge — db:5432, NOT localhost) ─────
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@db:5432/finscan
REDIS_URL=redis://redis:6379/0

# ─── LLM Provider ───────────────────────────────────────────────────
LLM_BACKEND=opencode
OPENCODE_API_KEY=sk-...

# ─── Version Stamping (auto-populated by infra/version.sh) ──────────
RELEASE_VERSION=1.0.0
GIT_SHA=unknown
BUILD_TIMESTAMP=unknown

# ─── CDN (optional — if React SPA served from CloudFront) ───────────
# Set this during npm build to point API calls at the EC2 domain:
# VITE_API_BASE_URL=https://finscan.yourdomain.com
