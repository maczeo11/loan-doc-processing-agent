# ── Stage 1: Build React SPA ──────────────────────────────────────────
FROM node:20-slim AS ui-builder
WORKDIR /ui
COPY apps/ui/package.json apps/ui/package-lock.json ./
RUN npm ci --production=false
COPY apps/ui/ .
RUN npm run build

# ── Stage 2: Python API ──────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml ./
# CPU-only torch first: ragas -> sentence-transformers pulls torch transitively,
# and on linux/x86_64 the default PyPI resolution grabs the full CUDA build
# (nvidia-cusparse/cusolver/cudnn/triton, several GB) even though this box has
# no GPU (per AGENTS.md: classifier/embeddings must be 100% CPU). Installing
# the CPU build from PyTorch's own index first means the main requirements.txt
# install below finds torch already satisfied and never touches the CUDA
# packages - this alone was enough to blow the disk on a t-class instance.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir --default-timeout=1000 --retries 5 -r requirements.txt
RUN pip install --no-cache-dir -e .

COPY . .

# Copy pre-built React SPA into the path FastAPI expects (apps/ui/dist)
COPY --from=ui-builder /ui/dist /app/apps/ui/dist

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
