# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
# These Python build dirs are anchored to the repo root on purpose.
# Unanchored, a bare `lib/` matches a directory named "lib" at ANY depth - it
# was silently excluding real source at apps/ui/src/lib/ (Firebase client
# init), which then had to be force-added to be tracked at all.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env.local
.env.*.local

# Databases & local state
*.sqlite3
*.db
local_queue/
checkpoints/
data/storage/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# UI / Node
**/node_modules/
apps/ui/dist/
ui/dist/
ui/.next/
apps/ui/.next/

